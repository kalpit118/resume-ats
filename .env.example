# ==============================================================================
# ResumeFit Environment Configuration Template
# ==============================================================================

# Backend Service Configuration (Render.com)
PORT=3001
NODE_ENV=production

# LaTeX Cloud Compilation Key (https://texapi.ovh)
TEXAPI_KEY=your_texapi_key_here

# Default AI Provider (groq | nim | mock)
AI_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
NIM_API_KEY=your_nim_api_key_here

# Frontend Configuration (Cloudflare Pages Dashboard)
# Set this in Cloudflare Pages -> Settings -> Environment Variables
VITE_API_BASE_URL=https://resumefit-backend.onrender.com
